# ==============================================================================
# SISTEM E-RESERVASI WALIKOTA JAKARTA TIMUR - SUPABASE CONFIGURATION
# ==============================================================================
# Masukkan Project URL dan Project Anon / Public Key dari dashboard Supabase Anda:
# Project Settings -> API -> Project URL & Project API Keys (anon public)
#
# Jika nilai dibiarkan kosong atau placeholder, aplikasi akan secara otomatis 
# dan mulus (seamless) beralih ke Persistent LocalStorage Mock Repository.
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

